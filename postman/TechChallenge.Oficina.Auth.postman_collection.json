    {
      "name": "09 - Lambda - Gerar JWT com CPF (200)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gatewayUrl}}/auth/token",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "auth",
            "token"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{auth0_username}}\",\n  \"senha\": \"{{auth0_password}}\",\n  \"cpf\": \"{{cpf_cliente}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function decodificarJwt(token) {",
              "  const payload = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
              "  return JSON.parse(atob(payload.padEnd(payload.length + (4 - payload.length % 4) % 4, '=')));",
              "}",
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const token = pm.response.json().access_token;",
              "pm.test('JWT tem a claim cpf do cliente cadastrado', function () {",
              "  pm.expect(decodificarJwt(token).cpf).to.eql(pm.collectionVariables.get('cpf_cliente'));",
              "});",
              "pm.collectionVariables.set('jwt_cpf', token);"
            ]
          }
        }
      ]
    },
