    {
      "name": "05 - Cadastrar Cliente com token sem CPF (201)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{auth0_access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gatewayUrl}}/monolith/api/clientes",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "monolith",
            "api",
            "clientes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nomeCompleto\": \"Cliente Token Lambda\",\n  \"identificacao\": \"{{cpf_cliente}}\",\n  \"email\": \"{{auth0_username}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function gerarCpfValido() {",
              "  const base = [];",
              "  for (let i = 0; i < 9; i++) base.push(Math.floor(Math.random() * 10));",
              "  let soma = 0;",
              "  for (let i = 0; i < 9; i++) soma += base[i] * (10 - i);",
              "  let resto = soma % 11;",
              "  const d1 = resto < 2 ? 0 : 11 - resto;",
              "  soma = 0;",
              "  for (let i = 0; i < 9; i++) soma += base[i] * (11 - i);",
              "  soma += d1 * 2;",
              "  resto = soma % 11;",
              "  const d2 = resto < 2 ? 0 : 11 - resto;",
              "  return [...base, d1, d2].join('');",
              "}",
              "const cpfCliente = gerarCpfValido();",
              "let cpfNaoCadastrado = gerarCpfValido();",
              "while (cpfNaoCadastrado === cpfCliente) cpfNaoCadastrado = gerarCpfValido();",
              "pm.collectionVariables.set('cpf_cliente', cpfCliente);",
              "pm.collectionVariables.set('cpf_nao_cadastrado', cpfNaoCadastrado);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
