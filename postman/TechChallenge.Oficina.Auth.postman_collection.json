    {
      "name": "03 - Auth0 - Token direto, sem CPF (200)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": {
          "raw": "https://{{auth0_domain}}/oauth/token",
          "protocol": "https",
          "host": [
            "{{auth0_domain}}"
          ],
          "path": [
            "oauth",
            "token"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "password",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{auth0_client_id}}",
              "type": "text"
            },
            {
              "key": "username",
              "value": "{{auth0_username}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{auth0_password}}",
              "type": "text"
            },
            {
              "key": "audience",
              "value": "{{auth0_audience}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function decodificarJwt(token) {",
              "  const payload = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
              "  return JSON.parse(atob(payload.padEnd(payload.length + (4 - payload.length % 4) % 4, '=')));",
              "}",
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const token = pm.response.json().access_token;",
              "pm.test('Token direto do Auth0 nao tem a claim cpf', function () {",
              "  pm.expect(decodificarJwt(token)).to.not.have.property('cpf');",
              "});",
              "pm.collectionVariables.set('auth0_access_token', token);"
            ]
          }
        }
      ]
    },
